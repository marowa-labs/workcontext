generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Document {
  id        BigInt                 @id @default(autoincrement())
  content   String
  metadata  Json?
  embedding Unsupported("vector")?

  @@map("documents")
}

// Unified context layer: vector embeddings for workspace items (projects, tasks, notes)
// used for semantic "related items" and cross-workspace RAG retrieval.
model ContextEmbedding {
  id           String   @id @default(uuid())
  owner_id     String // creator of the entity — used to scope retrieval when no workspace is available
  workspace_id String? // workspace the entity belongs to — primary retrieval scope
  entity_type  String // "project" | "task" | "note"
  entity_id    String
  title        String?
  content      String // plain-text used to generate the embedding
  embedding    Unsupported("vector")? // dimension-flexible (768 for Gemini, 1536 for OpenAI)
  dim          Int? // embedding dimension — used to keep same-dimension comparisons safe
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([owner_id])
  @@index([workspace_id])
  @@index([entity_type, entity_id])
  @@map("context_embeddings")
}

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  full_name                String?
  phone_number             String?
  otp_method               String?
  user_type                String?
  field_of_study           String?
  selected_plan            String?
  affiliate_ref            String?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  preferred_ai_model       String?

  byok_enabled             Boolean?                @default(false)
  byok_provider            String?
  byok_google_key_encrypted String?                @db.Text
  byok_claude_key_encrypted String?                @db.Text
  byok_openai_key_encrypted String?                @db.Text
  byok_openrouter_key_encrypted String?            @db.Text
  byok_key_version         Int?                    @default(1)

  byok_google_models       Json?
  byok_claude_models       Json?
  byok_openai_models       Json?
  byok_openrouter_models   Json?

  storage_used             Float?                  @default(0)
  storage_limit            Float?                  @default(5)
  bio                      String?
  institution              String?
  location                 String?
  ai_preferences           Json?
  user_role                String?
  heard_about_platform     String?
  user_goal                String?
  main_job                 String?
  survey_completed         Boolean?                @default(false)
  ai_chat_messages         AIChatMessage[]
  ai_chat_sessions         AIChatSession[]
  ai_feedback              AIFeedback[]
  ai_history               AIHistory[]
  ai_performance_metrics   AIPerformanceMetric[]
  ai_usage                 AIUsage[]
  collaborators            CollaboratorPresence[]
  document_templates       DocumentTemplate[]
  document_versions        DocumentVersion[]
  editor_activities        EditorActivity[]
  editor_events            EditorEvent[]
  editor_settings          EditorSettings?
  exports                  Export[]
  feedback_comments        FeedbackComment[]
  login_history            LoginHistory[]
  notifications            Notification[]
  notification_settings    NotificationSettings?
  otp_code                 OTPCode?
  projects                 Project[]
  push_notification_tokens PushNotificationToken[]
  support_tickets          SupportTicket[]
  task_trackings           TaskTracking[]
  feedback_items           UserFeedback[]
  privacy_settings         UserPrivacySettings?
  sessions                 UserSession[]
  audit_logs               AuditLog[]
  pdf_documents            PdfDocument[]
  ai_actions               AIAction[]

  owned_workspaces           Workspace[]           @relation("WorkspaceOwner")
  workspace_memberships      WorkspaceMember[]
  sent_workspace_invitations WorkspaceInvitation[] @relation("WorkspaceInviter")
  assigned_tasks             TaskAssignee[]        @relation("TaskAssignees")
  created_tasks              WorkspaceTask[]       @relation("TaskCreator")
  task_comments              TaskComment[]         @relation("UserTaskComments")
  time_entries               TaskTimeEntry[]
  collaboration_logs         CollaborationLog[]
  comments                   Comment[]
  external_tool_connections  ExternalToolConnection[]
  meeting_transcripts        MeetingTranscript[]
  decisions                  Decision[]
  activity_feed_items        ActivityFeedItem[]
  auto_summaries             AutoSummary[]
  embed_blocks               EmbedBlock[]
}

model Workspace {
  id            String                @id @default(uuid())
  name          String
  description   String?
  icon          String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt
  owner_id      String
  owner         User                  @relation("WorkspaceOwner", fields: [owner_id], references: [id])
  projects      Project[]
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  tasks         WorkspaceTask[]
  labels        WorkspaceLabel[]
  views         WorkspaceView[]
  custom_fields WorkspaceCustomField[]
  external_tool_connections ExternalToolConnection[]
  meeting_transcripts       MeetingTranscript[]
  decisions                 Decision[]
  activity_feed_items       ActivityFeedItem[]
  auto_summaries            AutoSummary[]

  @@index([owner_id])
}

model WorkspaceView {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  filters      Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
}

model WorkspaceMember {
  id           String    @id @default(uuid())
  workspace_id String
  user_id      String
  role         String    @default("viewer")
  role_id      String?  // FK to Role table for granular permissions
  joined_at    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roleEntry    Role?     @relation(fields: [role_id], references: [id])

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
  @@index([role_id])
}

model WorkspaceInvitation {
  id           String   @id @default(uuid())
  workspace_id String
  email        String
  role         String   @default("viewer")
  token        String   @unique @default(uuid())
  status       String   @default("pending")
  expires_at   DateTime
  invited_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  inviter   User      @relation("WorkspaceInviter", fields: [invited_by], references: [id])

  @@unique([workspace_id, email])
  @@index([token])
  @@index([email])
  @@index([status])
  @@index([expires_at])
}

model PushNotificationToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, token])
  @@index([user_id])
  @@index([token])
}

model Project {
  id                  String                 @id @default(uuid())
  user_id             String
  title               String
  type                String
  description         String?
  content             Json?
  word_count          Int                    @default(0)
  character_count     Int                    @default(0)
  paragraph_count     Int                    @default(0)
  last_updated        DateTime?
  due_date            DateTime?
  status              String                 @default("draft")
  citation_style      String?                @default("apa")
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  template_id         String?
  workspace_id        String?
  workspace           Workspace?             @relation(fields: [workspace_id], references: [id])
  ai_chat_sessions    AIChatSession[]
  collaborators       CollaboratorPresence[]
  collaboration_logs  CollaborationLog[]
  comments            Comment[]
  citations           Citation[]
  collaboration_invites CollaborationInvite[]
  share_settings      DocumentShareSettings?
  content_format      String                 @default("editor") // "editor" (TipTap) or "blocks" (BlockNote)
  block_content       Json?                  // BlockNote JSON format (used when content_format = "blocks")
  metadata            Json?                  // General-purpose metadata (import source, etc.)
  document_versions   DocumentVersion[]
  editor_activities   EditorActivity[]
  editor_events       EditorEvent[]
  exports             Export[]
  user                User                   @relation(fields: [user_id], references: [id], map: "ProjectToUser")
  template            DocumentTemplate?      @relation(fields: [template_id], references: [id])
  version_schedules   VersionSchedule[]
  tasks               WorkspaceTask[]
  decisions           Decision[]
  activity_feed_items ActivityFeedItem[]
  auto_summaries      AutoSummary[]
  embed_blocks        EmbedBlock[]
  @@index([user_id])
}

model PdfDocument {
  id         String   @id @default(uuid())
  user_id    String
  filename   String
  status     String   @default("processing")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("pdf_documents")
}

model CollaboratorPresence {
  id             String   @id @default(uuid())
  project_id     String
  user_id        String
  permission     String   @default("view")
  join_method    String?  @default("workspace_member")
  last_active_at DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  project        Project  @relation(fields: [project_id], references: [id])
  user           User     @relation(fields: [user_id], references: [id])

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@index([last_active_at])
  @@index([join_method])
}

model DocumentShareSettings {
  id                   String    @id @default(uuid())
  project_id           String    @unique
  link_sharing_enabled Boolean   @default(true)
  link_permission      String    @default("edit")
  require_sign_in      Boolean   @default(true)
  allow_download       Boolean   @default(true)
  notify_on_view       Boolean   @default(false)
  expiration           DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  project              Project   @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@index([link_sharing_enabled])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  project_id String
  user_id    String
  content    Json
  version    Int
  created_at DateTime @default(now())
  word_count Int      @default(0)
  project    Project  @relation(fields: [project_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@index([project_id])
  @@index([user_id])
  @@index([created_at])
}

model AIUsage {
  id                     String   @id @default(uuid())
  user_id                String
  month                  Int
  year                   Int
  request_count          Int      @default(0)
  chat_message_count     Int      @default(0)
  image_generation_count Int      @default(0)
  web_search_count       Int      @default(0)
  deep_search_count      Int      @default(0)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  average_response_time  Float    @default(0)
  feature_usage          Json?    @default("[]")
  most_used_actions      Json?    @default("[]")
  most_used_models       Json?    @default("[]")
  peak_usage_hours       Json?    @default("[]")
  success_rate           Float    @default(0)
  total_cost_estimate    Float    @default(0)
  total_tokens_used      Int      @default(0)

  grammar_check_count    Int      @default(0)
  summarization_count    Int      @default(0)
  document_qa_count      Int      @default(0)
  writing_project_count  Int      @default(0)

  byok_request_count     Int      @default(0)
  system_request_count   Int      @default(0)
  byok_cost_estimate     Float    @default(0)
  system_cost_estimate   Float    @default(0)

  user                   User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, month, year])
  @@index([user_id])
  @@index([month, year])
}

model OTPCode {
  id           String   @id @default(uuid())
  user_id      String   @unique
  otp_code     String
  method       String
  expires_at   DateTime
  created_at   DateTime @default(now())
  phone_number String?  @unique @db.VarChar(20)
  user         User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, method])
  @@index([user_id])
  @@index([phone_number])
  @@index([expires_at])
}

model Notification {
  id            String    @id @default(uuid())
  user_id       String
  type          String
  title         String
  message       String
  read          Boolean   @default(false)
  dismissed     Boolean   @default(false)
  snoozed_until DateTime?
  data          Json?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  user          User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([read])
  @@index([dismissed])
  @@index([created_at])
}

model NotificationSettings {
  id                                         String   @id @default(uuid())
  user_id                                    String   @unique
  project_activity_enabled                   Boolean  @default(true)
  project_activity_comments                  Boolean  @default(true)
  project_activity_mentions                  Boolean  @default(true)
  project_activity_changes                   Boolean  @default(true)
  project_activity_shared                    Boolean  @default(false)
  collaboration_enabled                      Boolean  @default(true)
  collaboration_new_collaborator             Boolean  @default(true)
  collaboration_permission_changes           Boolean  @default(true)
  collaboration_comments_resolved           Boolean  @default(true)
  collaboration_real_time                    Boolean  @default(false)
  ai_features_enabled                        Boolean  @default(true)
  ai_features_plagiarism_complete            Boolean  @default(true)
  ai_features_ai_limit                       Boolean  @default(false)
  ai_features_new_features                   Boolean  @default(true)
  ai_features_weekly_summary                 Boolean  @default(false)
  product_updates_enabled                    Boolean  @default(true)
  product_updates_new_features               Boolean  @default(true)
  product_updates_tips                       Boolean  @default(false)
  product_updates_newsletter                 Boolean  @default(false)
  product_updates_special_offers             Boolean  @default(false)
  writing_progress_enabled                   Boolean  @default(true)
  writing_progress_document_deadline         Boolean  @default(true)
  writing_progress_writing_streak            Boolean  @default(true)
  writing_progress_goal_achieved             Boolean  @default(true)
  document_management_enabled                Boolean  @default(true)
  document_management_backup_available       Boolean  @default(true)
  document_management_template_update        Boolean  @default(true)
  document_management_document_version       Boolean  @default(true)
  collaboration_request_enabled              Boolean  @default(true)
  collaboration_request_collaborator_request Boolean  @default(true)
  frequency                                  String   @default("real-time")
  quiet_hours_enabled                        Boolean  @default(false)
  quiet_hours_start_time                     String   @default("22:00")
  quiet_hours_end_time                       String   @default("08:00")
  push_notifications_enabled                 Boolean  @default(true)
  push_notifications_mentions                Boolean  @default(true)
  push_notifications_comments                Boolean  @default(true)
  push_notifications_direct_messages         Boolean  @default(true)
  push_notifications_marketing               Boolean  @default(false)
  in_app_notifications_enabled               Boolean  @default(true)
  in_app_notifications_sound                 Boolean  @default(true)
  in_app_notifications_desktop               Boolean  @default(true)
  created_at                                 DateTime @default(now())
  updated_at                                 DateTime @updatedAt
  sms_notifications_enabled                  Boolean  @default(false)
  sms_notifications_high_priority_only       Boolean  @default(true)
  user                                       User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model FailedWebhook {
  id          String   @id @default(uuid())
  event_name  String
  payload     Json
  retry_count Int      @default(0)
  last_error  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([event_name])
  @@index([created_at])
  @@index([retry_count])
}

model IdempotencyRecord {
  idempotency_key String    @id
  status          String
  result          String?
  error_message   String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  expires_at      DateTime?

  @@index([status])
  @@index([expires_at])
}

model AlertLog {
  id         String   @id @default(uuid())
  alert_type String
  message    String
  data       String?
  severity   String
  created_at DateTime @default(now())

  @@index([alert_type])
  @@index([severity])
  @@index([created_at])
}

model AIHistory {
  id            String   @id @default(uuid())
  user_id       String
  action        String
  original_text String
  suggestion    String
  is_favorite   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([is_favorite])
  @@index([created_at])
}

model AIChatSession {
  id              String          @id @default(uuid())
  user_id         String
  project_id      String?
  title           String          @default("New Chat")
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  last_message_at DateTime?
  is_active       Boolean         @default(true)
  messages        AIChatMessage[]
  project         Project?        @relation(fields: [project_id], references: [id])
  user            User            @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([project_id])
  @@index([is_active])
  @@index([created_at])
  @@index([last_message_at])
}

model AIChatMessage {
  id               String        @id @default(uuid())
  session_id       String
  user_id          String
  content          String
  role             String
  message_type     String        @default("text")
  image_url        String?
  file_url         String?
  metadata         Json?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  confidence_score Float?
  context_used     Json?
  mode             String        @default("general")
  session          AIChatSession @relation(fields: [session_id], references: [id])
  user             User          @relation(fields: [user_id], references: [id])

  @@index([session_id])
  @@index([user_id])
  @@index([role])
  @@index([created_at])
  @@index([mode])
}

model WorkspaceTask {
  id           String    @id @default(uuid())
  workspace_id String
  creator_id   String
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  due_date     DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  is_recurring               Boolean   @default(false)
  recurrence_pattern         String?
  recurrence_end_date        DateTime?
  recurrence_max_occurrences Int?
  parent_recurring_task_id   String?
  is_recurrence_exception    Boolean   @default(false)
  original_due_date          DateTime?

  project_id String?
  project    Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  estimated_hours Float?
  time_entries    TaskTimeEntry[]

  workspace    Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator      User               @relation("TaskCreator", fields: [creator_id], references: [id])
  assignees    TaskAssignee[]
  comments     TaskComment[]
  subtasks     WorkspaceSubtask[]
  labels       WorkspaceLabel[]   @relation("TaskLabels")
  attachments  TaskAttachment[]
  dependencies TaskDependency[]   @relation("TaskDependencies")
  blocked_by   TaskDependency[]   @relation("BlockedTasks")

  parent_task     WorkspaceTask?  @relation("RecurringTaskInstances", fields: [parent_recurring_task_id], references: [id], onDelete: Cascade)
  child_instances WorkspaceTask[] @relation("RecurringTaskInstances")

  is_template       Boolean   @default(false)
  template_name     String?
  template_category String?

  custom_field_values TaskCustomFieldValue[]

  @@index([workspace_id])
  @@index([creator_id])
  @@index([status])
  @@index([parent_recurring_task_id])
  @@index([is_recurring])
  @@index([due_date])
  @@index([project_id])
  @@index([is_template])
}

model TaskDependency {
  id            String   @id @default(uuid())
  task_id       String
  depends_on_id String
  type          String   @default("blocks")
  created_at    DateTime @default(now())

  task       WorkspaceTask @relation("TaskDependencies", fields: [task_id], references: [id], onDelete: Cascade)
  depends_on WorkspaceTask @relation("BlockedTasks", fields: [depends_on_id], references: [id], onDelete: Cascade)

  @@unique([task_id, depends_on_id])
  @@index([task_id])
  @@index([depends_on_id])
}

model WorkspaceSubtask {
  id         String   @id @default(uuid())
  task_id    String
  title      String
  is_done    Boolean  @default(false)
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task WorkspaceTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}

model WorkspaceLabel {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  color        String   @default("#94a3b8")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  tasks     WorkspaceTask[] @relation("TaskLabels")

  @@unique([workspace_id, name])
  @@index([workspace_id])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  task_id    String
  name       String
  file_url   String
  file_type  String
  file_size  Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task WorkspaceTask @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id])
}

model WorkspaceCustomField {
  id           String    @id @default(uuid())
  workspace_id String
  name         String
  type         String    @default("text")
  options      Json?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  values       TaskCustomFieldValue[]

  @@unique([workspace_id, name])
  @@index([workspace_id])
}

model TaskCustomFieldValue {
  id               String               @id @default(uuid())
  task_id          String
  field_id         String
  text_value       String?
  number_value     Float?
  date_value       DateTime?

  task             WorkspaceTask        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  field            WorkspaceCustomField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([task_id, field_id])
  @@index([task_id])
  @@index([field_id])
}

model TaskTimeEntry {
  id          String    @id @default(uuid())
  task_id     String
  user_id     String
  start_time  DateTime
  end_time    DateTime?
  duration    Int?
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  task WorkspaceTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User           @relation(fields: [user_id], references: [id])

  @@index([task_id])
  @@index([user_id])
}

model TaskAssignee {
  id                       String    @id @default(uuid())
  task_id                  String
  user_id                  String
  assigned_at              DateTime  @default(now())
  last_notified_soon_at    DateTime?
  last_notified_overdue_at DateTime?

  task WorkspaceTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User          @relation("TaskAssignees", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([task_id])
  @@index([user_id])
}

model TaskComment {
  id         String   @id @default(uuid())
  task_id    String
  user_id    String
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task WorkspaceTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User          @relation("UserTaskComments", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id])
}

model AIPerformanceMetric {
  id               String   @id @default(uuid())
  user_id          String
  model            String
  action           String
  response_time    Float
  tokens_used      Int
  success          Boolean
  error_message    String?
  timestamp        DateTime @default(now())
  content_length   Int      @default(0)
  context          String?
  cost_estimate    Float    @default(0)
  feature_category String?
  input_tokens     Int      @default(0)
  output_tokens    Int      @default(0)
